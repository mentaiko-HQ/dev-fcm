/**
 * 【Firestore セキュリティルール】
 *
 * 役割:
 * - データベースへの不正アクセスや意図しないデータ破壊をサーバーサイドで防ぐ（フェイルセーフ）。
 * - フロントエンドのバリデーションをすり抜けた不正リクエストを遮断。
 *
 * フールプルーフ設計（データ保護）:
 * - isValidEntryUpdate(): フロントエンドから送られてくる更新データのキー（affectedKeys）が、
 *   事前に許可されたリスト（hasOnly）に完全に一致する場合のみ update を許可。
 *   ※ 'isSokuchu' に加え、午前/午後の立順キー（stand1Group等）も網羅し既存機能を完全保護。
 */

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================
    // 認可・検証ヘルパー関数群
    // ==========================================

    // 1. 特権管理者判定
    function isSuperAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // 2. 運営スタッフ・記録員判定
    function isOperator() {
      return request.auth != null;
    }

    // 3. ユーザー自身判定（ログイン中UIDの一致検証）
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // 4. 射位（1〜5番）および立・組構造バリデーション
    function isValidStandStructure() {
      let data = request.resource.data;
      return (!('standOrder' in data) || data.standOrder == null || (data.standOrder is int && data.standOrder >= 1 && data.standOrder <= 5)) &&
             (!('standNumber' in data) || data.standNumber == null || (data.standNumber is int && data.standNumber >= 1)) &&
             (!('groupNumber' in data) || data.groupNumber == null || (data.groupNumber is int && data.groupNumber >= 1));
    }

    // 5. エントリー更新バリデーション（既存機能をすべて維持するホワイトリスト）
    function isValidEntryUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly([
          'name', 'nameKana', 'email', 'organization', 'teamId', 'teamName',
          'shosa', 'rankTitle',
          'needsSupport', 'staffRole', 'staffDutyShift', 'notes',
          'isPaid', 'paidAt', 'bibNumber', 'standAssignments',
          'standNumber', 'groupNumber', 'standGroup', 'standOrder',
          'stand1Group', 'stand1Order', 'stand2Group', 'stand2Order',
          'checkInStatus', 'checkInAt', 'checkInMethod',
          'qualificationStatus', 'progressStatus',
          'stand1_arrows', 'stand2_arrows', 'stand3_arrows',
          'stage1Shots', 'stage2Shots', 'stage3Shots',
          'isHayaHit', 'isSokuchu', 'totalHits', 'totalShots', 'isPerfect',
          'enkinRank', 'finalRank',
          'qrSentStatus', 'qrSentAt', 'qrSentError', 'updatedAt'
        ]) && isValidStandStructure();
    }

    // ==========================================
    // 各コレクション アクセス制御定義
    // ==========================================

    match /users/{userId} {
      allow read: if true;
      allow create, update: if request.auth != null && (isOwner(userId) || isOperator());
      allow delete: if isOperator();
    }

    match /teams/{teamId} {
      allow read: if true;
      allow create, update, delete: if isOperator();
    }

    // エントリー（参加者データ・スコア記録）
    match /entries/{entryId} {
      allow read: if true;
      allow create: if true;
      allow update: if isValidEntryUpdate() || isSuperAdmin();
      allow delete: if isOperator() || isSuperAdmin();
    }

    match /matches/{matchId} {
      allow read: if true;
      allow create, update, delete: if true;

      // FCM呼出通知ログ サブコレクション
      match /call_logs/{logId} {
        allow read: if true;
        allow create, update, delete: if true;
      }
    }

    match /scores/{scoreId} {
      allow read: if true;
      allow create, update, delete: if true;
    }
  }
}