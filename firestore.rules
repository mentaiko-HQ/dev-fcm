rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ユーザーがシステム管理者（役員）であるか判定するヘルパー関数（フールプルーフ）
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // ユーザー自身のリソースであるか判定するヘルパー関数
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // users コレクション（FCMトークン・選択チーム管理）
    match /users/{userId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isAdmin();
    }

    // teams コレクション（立順、チーム構成）
    match /teams/{teamId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // entries コレクション（参加選手・立順データ・3層ステータス・スコア）
    match /entries/{entryId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // matches コレクション（大会設定、進行管理、競技形式設定）
    match /matches/{matchId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // scores コレクション（予選・決勝スコアデータ）
    match /scores/{scoreId} {
      allow read: if true;
      allow create, update, delete: if true;
    }
  }
}