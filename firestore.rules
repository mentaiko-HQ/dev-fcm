rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ユーザーがシステム管理者（役員）であるか判定するヘルパー関数
    // フールプルーフ: トークンおよび管理者クレームの存在を厳密に検証
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // ユーザー自身のリソースであるか判定するヘルパー関数
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // users コレクション（FCMトークン・チーム紐付け）
    match /users/{userId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isAdmin();
    }

    // teams コレクション（立順、チーム構成）
    match /teams/{teamId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // entries コレクション（参加者・立順データ・最終順位）
    match /entries/{entryId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // matches コレクション（試合進行、立の進行管理、競技形式設定）
    match /matches/{matchId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // scores コレクション（リアルタイム的中データ）
    match /scores/{scoreId} {
      allow read: if true;
      allow create, update, delete: if true;
    }
  }
}