rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================
    // 認可・検証ヘルパー関数群
    // ==========================================

    // 1. 特権管理者判定（Custom Claims: admin === true）
    function isSuperAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // 2. 運営スタッフ判定（フェイルセーフ: Claims未設定時でもパスワード認証済み運営アカウントの操作を継続）
    function isOperator() {
      return request.auth != null &&
        (
          request.auth.token.admin == true ||
          (request.auth.token.firebase.sign_in_provider == 'password' && request.auth.token.email_verified != false)
        );
    }

    // 3. ユーザー自身判定（ログイン済みUIDの一致検証）
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // 4. エントリー更新バリデーション（フールプルーフ: 許可された運営管理キー以外の改ざんを入口で遮断）
    function isValidEntryUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly([
          'isPaid', 'paidAt', 'bibNumber', 'standAssignments',
          'checkInStatus', 'checkInAt', 'checkInMethod',
          'qualificationStatus', 'progressStatus',
          'stand1_arrows', 'stand2_arrows', 'stand3_arrows',
          'isHayaHit', 'totalHits', 'totalShots', 'isPerfect',
          'enkinRank', 'finalRank',
          'qrSentStatus', 'qrSentAt', 'qrSentError', 'updatedAt'
        ]);
    }

    // ==========================================
    // 各コレクション アクセス制御定義
    // ==========================================

    // users コレクション: 参加者の端末情報・FCMトークン
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && isOwner(userId);
      allow update: if request.auth != null && (isOwner(userId) || isOperator());
      allow delete: if isOperator();
    }

    // teams コレクション: 参加チーム・立ち順
    match /teams/{teamId} {
      allow read: if true;
      allow create, update, delete: if isOperator();
    }

    // entries コレクション: 大会参加選手リスト
    match /entries/{entryId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if isOperator() && isValidEntryUpdate();
      allow delete: if isSuperAdmin();
    }

    // matches コレクション: 大会設定・進行状態・呼出状態
    match /matches/{matchId} {
      allow read: if true;
      allow create, update, delete: if isOperator();
    }

    // scores コレクション: 的中記録（射詰・遠近・本戦）
    match /scores/{scoreId} {
      allow read: if true;
      allow create, update: if isOperator();
      allow delete: if isSuperAdmin();
    }
  }
}