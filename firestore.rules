rules_version = '2';
service cloud.firestore {
  // 【フールプルーフ修正】初期ルールの「daabases」タイポを「databases」へ修正
  match /databases/{database}/documents {

    // ユーザーが認証済み（匿名認証を含む）であるか判定するヘルパー関数
    function isAuthenticated() {
      return request.auth != null;
    }

    // ユーザーがシステム管理者（カスタムクレーム admin == true）または認証済み運営端末であるか判定する関数
    // ※管理画面（/admin）を匿名認証環境でも運用可能にしつつ、未認証の外部リクエストを遮断
    function isAdminOrStaff() {
      return request.auth != null && (
        request.auth.token.admin == true ||
        request.auth.uid != null
      );
    }

    // ユーザー自身のリソースであるか判定するヘルパー関数
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // 1. users コレクション（/standby での選手紐付け・FCMトークン保存用）
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isOwner(userId);
      allow update: if isAuthenticated() && (isOwner(userId) || isAdminOrStaff());
      allow delete: if isAdminOrStaff();
    }

    // 2. teams コレクション
    match /teams/{teamId} {
      allow read: if true;
      allow create, update, delete: if isAdminOrStaff();
    }

    // 3. entries コレクション（参加選手データ・スコア・進行ステータス）
    match /entries/{entryId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAdminOrStaff();
    }

    // 4. matches コレクション（大会設定・現在招集中の組 activeCallGroup 管理）
    match /matches/{matchId} {
      allow read: if true;
      allow create, update, delete: if isAdminOrStaff();

      // 招集通知配信履歴サブコレクション (call_logs)
      match /call_logs/{logId} {
        allow read: if true;
        allow create, update, delete: if isAdminOrStaff();
      }
    }

    // 5. tournament_guidelines コレクション（大会要項管理）
    match /tournament_guidelines/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdminOrStaff();
    }

    // 6. scores コレクション
    match /scores/{scoreId} {
      allow read: if true;
      allow create, update, delete: if isAdminOrStaff();
    }
  }
}